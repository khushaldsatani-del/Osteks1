# Copy this file to ".env" and fill in your key + database URL.

# Your OpenAI API key (https://platform.openai.com/api-keys) — the account
# needs credits/billing set up; OpenAI has no meaningful free tier for API
# calls (unlike Gemini's old free daily quota).
OPENAI_API_KEY=

# Model used for both extraction stages. Verified live against the real
# API (2026-08): gpt-5-mini is dramatically cheaper per image than
# gpt-4o-mini (~822 vs ~25,558 prompt tokens for the same drawing in
# testing) and supports vision + structured JSON output, so it's the
# default. Change only after checking token cost on your own account —
# model names/pricing shift often enough that this is worth re-verifying
# rather than trusting documentation.
OPENAI_MODEL=gpt-5-mini

# gpt-5-mini is a reasoning model — hidden "thinking" tokens are drawn from
# the same completion-token budget as the visible answer, so this directly
# trades cost for accuracy on hard-to-read drawings. One of: minimal, low,
# medium, high (all verified working live). "minimal" is cheapest/least
# careful; "high" is most careful/most expensive.
OPENAI_REASONING_EFFORT=medium

# Max completion tokens (visible output + hidden reasoning combined) per
# extraction stage. Set generously — a too-low value doesn't just truncate
# loudly; hidden reasoning tokens are drawn from this same budget first, so
# a tight cap can silently crowd out fields from the visible candidate
# list before the model ever finishes reasoning (confirmed live: at
# reasoning_effort=high, 8192 was entirely consumed by reasoning with zero
# tokens left for output — a hard truncation error, not a quiet omission,
# but the same crowding happens more subtly at lower effort levels once a
# drawing needs several high-resolution regions to cover). 16384 leaves
# real headroom for both. Stage 2 (validation) does more reasoning than
# stage 1 (plain enumeration), which is why it has its own knob.
OPENAI_MAX_TOKENS_STAGE1=16384
OPENAI_MAX_TOKENS_STAGE2=16384

# Postgres connection string (Neon: https://console.neon.tech, "Connection
# string" on the project dashboard). Documents/calculation/offer-details and
# uploaded emails are persisted here — tables are created automatically on
# startup if they don't exist yet.
DATABASE_URL=

# Optional overrides
PORT=5001
# Comma-separated list of origins allowed to call this API.
# Leave unset in local dev to allow any origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Google Cloud Storage bucket that Test Report photos are uploaded to (see
# services/gcs_storage.py) — nothing image-related is ever stored in
# Postgres. The bucket itself + the IAM binding granting this app's
# service account access to it are created manually (see backend/README.md
# for the exact steps); this just points the app at it by name.
GCS_BUCKET_NAME=

# Only needed for LOCAL development. On Cloud Run the attached service
# account is used automatically (Application Default Credentials) — no key
# file involved. Locally, either run `gcloud auth application-default
# login` once (nothing to set here then), or point this at a downloaded
# service-account JSON key file if you'd rather not install gcloud.
# GOOGLE_APPLICATION_CREDENTIALS=

# Also only needed for LOCAL development, and only when using `gcloud auth
# application-default login` (a personal-account credential with no
# project attached to it, unlike a service-account key). Without this,
# google-cloud-storage raises "Project was not passed and could not be
# determined from the environment" even though auth itself succeeded. Not
# needed on Cloud Run — the project is auto-detected from instance
# metadata there regardless of whether this is set.
GOOGLE_CLOUD_PROJECT=
